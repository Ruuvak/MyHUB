{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyHUB",
  "version": "../package.json",
  "identifier": "local.myhub.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyHUB",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false
      },
      {
        "label": "flyout",
        "title": "MyHUB",
        "url": "index.html",
        "width": 380,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMTEyRDVCMEFGRjNFODgKUldTSVB2OEtXeTBSUDE5amhnM2RTM2pSemg1STZ4amtCQVV1VkpnaVlITHRlL2R3bEhGVEpQcDUK",
      "endpoints": [
        "https://github.com/Ruuvak/MyHUB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
